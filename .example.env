# Hugging Face model; local mode downloads PyTorch/runtime and the model on first use.
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_EMBEDDING_MODE=local
# For hosted inference instead of local model downloads, set mode to endpoint and provide a token.
# HF_EMBEDDING_MODE=endpoint
# HUGGINGFACEHUB_API_TOKEN=your-hugging-face-token

# Groq is used only by the optional answer-generation script
GROQ_API_KEY=your-groq-api-key

# Optional Chroma Cloud credentials; selected-CVE ingestion uses local Chroma.
CHROMA_API_KEY=your-chroma-api-key
CHROMA_TENANT=your-chroma-tenant
CHROMA_DATABASE=your-chroma-database

# Chroma collection and local storage
CHROMA_COLLECTION=cve_huggingface_minilm
CHROMA_PERSIST_DIRECTORY=Database/chroma_db

# LangSmith tracing; add your API key from https://smith.langchain.com/
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-tracing