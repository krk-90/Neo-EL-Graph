# Copy this file to .env and set only the credentials for services you use.

# Embeddings. Local mode downloads the model and its runtime on first use.
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_EMBEDDING_MODE=local
# For hosted inference, set HF_EMBEDDING_MODE=endpoint and provide a token.
# HF_EMBEDDING_MODE=endpoint
# HUGGINGFACEHUB_API_TOKEN=your-hugging-face-token

# Optional Groq answer generation.
GROQ_API_KEY=

# Optional NVD API key; increases NVD API rate limits.
NVD_API_KEY=

# Optional Chroma Cloud credentials. Leave blank for local Chroma.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# Chroma collection and local storage.
CHROMA_COLLECTION=cve_huggingface_minilm
CHROMA_PERSIST_DIRECTORY=Database/chroma_db

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-tracing

# Optional runtime overrides. Defaults are in config.yml.
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# NETWORK_MAX_HOSTS=256
# NETWORK_MAX_PORTS=64
# NETWORK_MAX_CONCURRENT=32
# NETWORK_REQUEST_TIMEOUT_SECONDS=3